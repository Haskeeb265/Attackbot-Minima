# Recon tool configs with API keys (amass datasources)
service/recon_pipeline/pipelines/subdomain_domain_wildcards/passive/config/

# subdomain_domain_wildcards pipeline run artifacts: raw per-tool output,
# per-tool logs, the normalized/resolved host lists, validated resolver pools,
# zone-transfer results, and report.json. All of it is reproduced by running the
# stages (`python -m ...passive.pipeline`, `...active.pipeline`,
# `...permutation.pipeline`) or the orchestrator (`...main`), so none of it
# belongs in git. The curated seed data (active/resolvers/, active/wordlists/)
# is NOT ignored - that is source.
service/recon_pipeline/pipelines/subdomain_domain_wildcards/passive/output/
service/recon_pipeline/pipelines/subdomain_domain_wildcards/active/output/
service/recon_pipeline/pipelines/subdomain_domain_wildcards/permutation/output/
service/recon_pipeline/pipelines/subdomain_domain_wildcards/output/

# port_service_host stage run artifacts: the scan set, passive intel, CDN verdicts,
# open ports, service identities, per-tool raw output and the run report. Like the
# sibling stage's, these are fully reproducible by re-running the stage (see that
# stage's README for the measured yields), so they are not tracked.
service/recon_pipeline/pipelines/port_service_host/output/

# url_endpoint stage run artifacts: per-source raw URL lists, the canonical union,
# the derived endpoints/parameters/JS/interesting lists and the run reports. Same
# rule as the siblings - reproduced by re-running the stage, never tracked.
service/recon_pipeline/pipelines/url_endpoint/passive/output/
service/recon_pipeline/pipelines/url_endpoint/output/

# asn_cidr stage run artifacts: discovered network claims and scope files.
# Same rule as the siblings - reproduced by re-running the stage, never tracked.
service/recon_pipeline/pipelines/asn_cidr/output/

# graph_normalize stage run artifacts: the node/edge model, its vocabulary
# mapping and the run report. Reproduced by re-running the stage over the
# siblings' artifacts, never tracked.
service/recon_pipeline/pipelines/graph_normalize/output/

# cloud_resource stage run artifacts: harvested bucket-name candidates and the
# provider probe verdicts (buckets, dangling refs). Same rule as the siblings -
# reproduced by re-running the stage, never tracked.
service/recon_pipeline/pipelines/cloud_resource/passive/output/
service/recon_pipeline/pipelines/cloud_resource/output/

# ASM platform run artifacts: one directory per run (summary.json + a report per
# stage), the shared run timeline runs.jsonl the `history` command reads, and the
# graph journal (writes offered to the graph sink while no schema exists — the
# future migration's replay source). All of it is state, not source — the
# pipelines' curated inputs stay tracked.
/output/

# `run_recon.py --until-converged` artifacts, written next to the combined report:
# the round-by-round account and the per-engagement frontier ledger. State, not
# source, and reproduced by re-running the loop.
/recon_*_convergence_*.json
/recon_*_ledger_*.jsonl
/recon_*_attempts_*.jsonl
/recon_*_program_scope_*.txt

# The assembled combined report `run_recon.py` writes to the project root.
# Regenerated by every run; state, not source.
/recon_*_OUTPUT.md

# Scratch directories used for ad-hoc live verification runs (wordlist/resolver
# experiments, temporary mounts). Never source.
.tmp_*/
