# Attackbot environment template.
#
# Copy to `.env` at the repo root and fill in what you need:
#
#   cp .env.example .env
#
# `.env` is gitignored; this file is not. config.py (root) and
# service/recon_pipeline/platform/common/config.py both load it with
# override=True at import time, so it wins over any stale shell variables.
#
# Boot order matters for the datastore blocks: `docker compose up` reads
# POSTGRES_* and NEO4J_* from this file, and Neo4j sets its initial admin
# password from NEO4J_USERNAME/NEO4J_PASSWORD on FIRST boot only — get the
# values right before the first `up`, or reset credentials afterwards.

# --- PostgreSQL (scraper + db layer; REQUIRED for docker compose) ----------
# docker-compose.yml interpolates these verbatim: they must be set, it does
# not default them. POSTGRES_HOST/PORT are for the Python side; the defaults
# match the compose service.
POSTGRES_USER=attackbot
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=attackbot
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- Neo4j (recon graph + program intelligence; REQUIRED for docker compose)
# NEO4J_USERNAME must be `neo4j` on first boot (Community Edition requirement).
# NEO4J_DATABASE can stay `neo4j` unless you created another database.
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=change-me-local-only
NEO4J_DATABASE=neo4j

# --- HackerOne API (scraper only; leave empty to skip scraping) -------------
# Basic-auth credentials: your H1 username and an API token from
# https://hackerone.com/settings/api_token
HACKERONE_USERNAME=
HACKERONE_TOKEN=

# --- Vuln engine LLM junctions (optional) -----------------------------------
# No key = every junction runs degraded (deterministic) BY DESIGN and the
# engine's behavior is unchanged; set a key only when you want the advisory
# model influence. Defaults point at Groq's OpenAI-shaped endpoint; override
# URL/MODEL to use any OpenAI-compatible chat-completions provider.
VULN_ENGINE_LLM_API_KEY=
#VULN_ENGINE_LLM_API_URL=https://api.groq.com/openai/v1/chat/completions
#VULN_ENGINE_LLM_MODEL=openai/gpt-oss-20b
#VULN_ENGINE_LLM_MAX_COMPLETION_TOKENS=8192

# --- Recon: target + optional data-source keys ------------------------------
# Default target when a command is run without -t (common/config.py).
TARGET=qbsco.net
# Passive sources degrade gracefully to "skipped" when their key is missing —
# every one of these is optional.
CHAOS_KEY=
URL_URLSCAN_KEY=
SHODAN_KEY=
CENSYS_KEY=
VIRUS_TOTAL_KEY=
SECURITY_TRAILS_KEY=
GITHUB_KEY=

# --- Recon: tool images (optional; in-code defaults are usually right) ------
# Set only if you built an image under a different tag.
#SUBDW_IMAGE=subdomain_domain_wildcards_image

# --- Redis (planned, not consumed yet) ---------------------------------------
#REDIS_URL=redis://localhost:6379/0

# The remaining env vars the code reads are run-tuning knobs with in-code
# defaults (stealth identity/quarantine, scan ladder levels, port lists,
# fixture timing, etc.) — see the pipeline READMEs and docs/codebase/ for
# those. Nothing here is required to boot.
